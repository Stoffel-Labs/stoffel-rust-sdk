# Secret arithmetic: +, -, * all work on secret types.
# Addition is free (local share operation).
# Multiplication triggers a network round (Beaver triples).

def compute_total(price: secret int64, quantity: secret int64) -> secret int64:
  var subtotal: secret int64 = price * quantity
  var tax: secret int64 = subtotal * 10 / 100
  return subtotal + tax

main main() -> nil:
  var price: secret int64 = 150
  var quantity: secret int64 = 4

  var total: secret int64 = compute_total(price, quantity)

  # Reveal the total — inputs stay secret
  var result: int64 = total
  discard result
